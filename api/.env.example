# Copy to .env (ignored by git) and adjust. Every value shown is the default.

# Models. MODEL_PATH is served by default; ALT_MODEL_PATH enables the other part
# via ?part=B. `make download-weights` writes both files to ./models/.
MODEL_PATH=models/csrnet-partA.pth
MODEL_PART=A
# ALT_MODEL_PATH=models/csrnet-partB.pth

# Upload limits
MAX_UPLOAD_MB=10
MAX_LONG_SIDE=1600
MAX_IMAGE_PIXELS=60000000

# Inference: one model instance, a bounded queue, then 503 with Retry-After
DEVICE=cpu
TORCH_THREADS=1
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE=4
RETRY_AFTER_S=2

# Comma-separated list of allowed origins. Never "*".
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Copy to .env (ignored by git) and adjust. Every value shown is the default.

# Models. MODEL_PATH is the dense-crowd model. ALT_MODEL_PATH adds the sparse-scene model, and
# photos are then sent to the better-suited one automatically (?part=A or ?part=B overrides).
# `make download-weights` checks both files in ./models/.
MODEL_PATH=models/csrnet-partA.pth
MODEL_PART=A
# ALT_MODEL_PATH=models/csrnet-partB.pth

# Choose the dense or sparse model for each photo (needs ALT_MODEL_PATH)
AUTO_ROUTE=True

# Labelled boxes (?detect=true): a YOLO weights file; needs `pip install ultralytics`.
# DETECTOR_PATH=models/yolo11n.pt
# DETECTOR_CONF=0.3

# Upload limits
MAX_UPLOAD_MB=10
MAX_LONG_SIDE=1024
MAX_IMAGE_PIXELS=60000000

# Inference: one model instance, a bounded queue, then 503 with Retry-After
DEVICE=cpu
TORCH_THREADS=1
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE=4
RETRY_AFTER_S=2

# Comma-separated list of allowed origins. Never "*".
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
